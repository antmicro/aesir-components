{
  "typography": {
    "body": {
      "$type": "typography",
      "$description": "Default body text",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.base}",
        "fontWeight": "{font.weight.normal}",
        "letterSpacing": "{font.letter-spacing.normal}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "heading": {
      "h1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.4xl}",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": "{font.letter-spacing.tight}",
          "lineHeight": "1.1"
        }
      },
      "h2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.3xl}",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": "{font.letter-spacing.tight}",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.lg}",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": "{font.letter-spacing.tight}",
          "lineHeight": "1.4"
        }
      },
      "h4": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.base}",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": "{font.letter-spacing.tight}",
          "lineHeight": "{font.line-height.base}"
        }
      },
      "h5": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.sm}",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": "{font.letter-spacing.tight}",
          "lineHeight": "{font.line-height.sm}"
        }
      },
      "h6": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.xs}",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": "{font.letter-spacing.tight}",
          "lineHeight": "{font.line-height.xs}"
        }
      }
    },
    "supporting": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.normal}",
        "letterSpacing": "{font.letter-spacing.normal}",
        "lineHeight": "{font.line-height.sm}"
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.normal}",
        "letterSpacing": "0",
        "lineHeight": "{font.line-height.sm}"
      }
    },
    "quote": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.normal}",
        "letterSpacing": "{font.letter-spacing.normal}",
        "lineHeight": "{font.line-height.xl}"
      }
    }
  },
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": {
        "color": "#00000000",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      }
    },
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": "#00000024",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": "#00000029",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "6px",
        "spread": "0px"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "color": "#0000002e",
        "offsetX": "0px",
        "offsetY": "10px",
        "blur": "16px",
        "spread": "0px"
      }
    },
    "xl": {
      "$type": "shadow",
      "$value": {
        "color": "#00000033",
        "offsetX": "0px",
        "offsetY": "18px",
        "blur": "28px",
        "spread": "0px"
      }
    }
  }
}
