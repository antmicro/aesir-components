{
  "name": "@aesir/html",
  "private": true,
  "version": "0.1.0",
  "description": "Aesir Custom Elements for framework-independent web interfaces.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "aesir",
    "components",
    "custom-elements",
    "design-system",
    "web-components"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config vite.config.js && node build-components.mjs && vite build --config vite.icons.config.js",
    "dev": "vite --config vite.config.js",
    "test": "npm run build && npm run test:unit && npm run test:browser",
    "test:unit": "vitest run --config vitest.config.js",
    "test:browser": "vitest run --config vitest.browser.config.js",
    "test:browser:debug": "npm run build && vitest --config vitest.browser.config.js --browser.headless=false"
  },
  "exports": {
    ".": "./dist/aesir-html.min.js",
    "./icons": "./dist/aesir-icons.min.js",
    "./components/*": "./dist/components/*.min.js",
    "./core.css": "./dist/aesir-core.css",
    "./fonts.css": "./dist/aesir-fonts.css",
    "./typography.css": "./dist/aesir-typography.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@aesir/css": "0.1.0",
    "@aesir/svelte": "0.1.0",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@vitest/browser-playwright": "^4.1.11",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "svelte": "^5.51.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
