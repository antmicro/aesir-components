{
  "name": "@aesir/docs",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "pretest": "svelte-kit sync",
    "test": "vitest run",
    "predev": "npm run build --workspace @aesir/css && npm run build --workspace @aesir/svelte",
    "dev": "vite dev",
    "check:types": "svelte-kit sync && svelte-check --tsconfig jsconfig.json",
    "prebuild": "node ../../tools/docs/copy-token-exports.mjs && svelte-kit sync",
    "build": "vite build && node ../../tools/docs/finalize-static.mjs build && node ../../tools/docs/check-static-pages.mjs apps/docs/build",
    "preview": "vite preview",
    "sync": "svelte-kit sync || echo ''"
  },
  "dependencies": {
    "@aesir/css": "0.1.0",
    "@aesir/svelte": "0.1.0",
    "@aesir/tokens": "1.0.0",
    "@lucide/svelte": "^1.47.0",
    "mode-watcher": "^1.1.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "jsdom": "^29.1.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "js-yaml": "^4.3.2",
    "mdsvex": "^0.12.6",
    "shiki": "^4.0.1",
    "svelte": "^5.51.0",
    "vite": "^7.3.1",
    "vite-plugin-devtools-json": "^1.0.0"
  }
}
