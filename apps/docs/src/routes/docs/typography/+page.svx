	{#snippet renderCell(row, column)}
		{#if column.key === 'preview'}
			<td class="type-preview-cell">
				<span class="type-preview" style={`font-size: var(${row.token})`}>{row.sample}</span>
			</td>
		{/if}
	{/snippet}
</DocsCopyTable>

