## Semantic typography showcase

This article-style block combines headings, body text, emphasis, links, quotes, code, and supporting copy using the optional semantic defaults.

<SemanticTypographyShowcase />

<style>
	.font-family-copy {
		display: grid;
		gap: var(--ds-spacing-1);
		min-width: 0;
		text-align: left;
	}

	.font-family-copy p {
		margin: 0;
	}

	.font-family-copy__label {
		color: var(--ds-foreground-muted);
		font-size: var(--ds-font-size-xs);
		line-height: var(--ds-font-line-height-xs);
		text-transform: uppercase;
	}

	.font-family-copy__sample {
		color: var(--ds-foreground);
		font-size: var(--ds-font-size-lg);
		font-weight: var(--ds-font-weight-medium);
		line-height: var(--ds-font-line-height-lg);
	}

	.font-family-copy__sample[data-family='mono'],
	.font-family-copy__token,
	.font-family-copy__stack {
		font-family: var(--ds-font-family-mono);
	}

	.font-family-copy__token,
	.font-family-copy__stack {
		color: var(--ds-foreground-muted);
		font-size: var(--ds-font-size-xs);
		line-height: var(--ds-font-line-height-xs);
	}

	.font-family-copy__stack {
		opacity: var(--ds-opacity-80);
		overflow-wrap: anywhere;
	}

	.type-preview-cell {
		padding: var(--ds-spacing-3);
	}

	.type-preview,
	.weight-preview,
	.tracking-preview {
		margin: 0;
		color: var(--ds-foreground);
		letter-spacing: var(--ds-font-letter-spacing-tight);
	}

	.type-preview {
		font-weight: var(--ds-font-weight-normal);
	}

	.weight-preview {
		font-size: var(--ds-font-size-lg);
		line-height: var(--ds-font-line-height-lg);
	}

	.tracking-preview {
		font-size: var(--ds-font-size-base);
		line-height: var(--ds-font-line-height-base);
	}
</style>
